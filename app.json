{
  "expo": {
    "name": "Run Tracker",
    "slug": "RunTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Run Tracker needs your location to track your runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Run Tracker needs background location to keep tracking your run when your screen is locked.",
        "UIBackgroundModes": ["location"],
        "NSMotionUsageDescription": "Run Tracker uses motion data to count your steps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.ayoubghcoding.RunTracker",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDZuuA2Vbx-KCeotKj71Oo1GPKVCVH6Ad8"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0A1A",
          "dark": {
            "backgroundColor": "#0B0A1A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Run Tracker to use your location to track runs, including when the app is in the background."
        }
      ],
      ["expo-notifications"]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65181761-b076-4305-8bcc-e1781e6aec88"
      }
    }
  }
}
